<%- include('partials/head') %>
<%- include('partials/header') %>
<main>
  <div class="page-banner"><div class="container">
    <h1>Search: “<%= q %>”</h1>
    <p><%= results.length %> result<%= results.length !== 1 ? 's' : '' %> found</p>
  </div></div>
  <div class="container body-wrap">
    <div class="content-col">
      <form class="filter-bar" action="/search" method="get">
        <input type="search" name="q" value="<%= q %>" placeholder="Search again…">
        <button type="submit">Search</button>
      </form>
      <div class="card-grid">
        <% if (results.length) { %>
          <% results.forEach((item) => { %><%- include('partials/card', { item }) %><% }); %>
        <% } else { %>
          <p class="empty-state">No results for “<%= q %>”. Try a shorter keyword, e.g. “bank”, “SQL”, “bcs”.</p>
        <% } %>
      </div>
    </div>
    <%- include('partials/sidebar') %>
  </div>
</main>
<%- include('partials/footer') %>
