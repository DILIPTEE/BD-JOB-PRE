<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' && title ? title : site.site_name %></title>
<meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : site.tagline %>">
<meta name="keywords" content="<%= typeof keywords !== 'undefined' && keywords ? keywords : site.meta_keywords %>">
<link rel="canonical" href="<%= site.base_url %><%- path %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= site.site_name %>">
<meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title : site.site_name %>">
<meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : site.tagline %>">
<meta property="og:url" content="<%= site.base_url %><%- path %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="robots" content="index, follow">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E📘%3C/text%3E%3C/svg%3E">
<link rel="stylesheet" href="/css/style.css">
<% if (site.analytics_id && site.analytics_id.trim()) { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= site.analytics_id %>"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','<%= site.analytics_id %>');</script>
<% } %>
<% if (site.adsense_header && site.adsense_header.trim()) { %>
<%- site.adsense_header %>
<% } %>
<% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
<script type="application/ld+json"><%- JSON.stringify(jsonLd) %></script>
<% } %>
</head>
<body>
